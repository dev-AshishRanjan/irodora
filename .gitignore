# ---------------------------------------------------------------------------
# Irodora — .gitignore
#
# Principle: the repository is the system of record. Everything that carries
# durable meaning is COMMITTED — including .harness/ in full (state, memory,
# plans). Only machine-regenerable output and secrets are ignored.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnpm-store/
.yarn/
.npm/

# Build output
dist/
build/
out/
lib/
*.tsbuildinfo
.next/
.turbo/
.expo/
.expo-shared/
web-build/
*.jsbundle

# Native mobile build artefacts (generated by prebuild — never hand-edited)
apps/mobile/ios/
apps/mobile/android/
*.ipa
*.apk
*.aab
*.keystore
!debug.keystore

# Signing key material. *.keystore and *.key were already here; PKCS#12 was NOT,
# and on 2026-08-24 a release keystore generated in the repository root was committed
# and pushed to a PUBLIC repository by a `git add -A`. The key had to be destroyed and
# regenerated. scripts/verify-no-key-material.mjs now fails the build on any of these
# being TRACKED, because a .gitignore entry only helps for a file nobody force-added.
*.p12
*.pfx
*.jks
*.crt
*.cer
*.der
*.p8
*.mobileprovision

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/**/*.key
secrets/
.secrets/

# Test & coverage output
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/
tests/**/results/
tests/**/.cache/

# Verification evidence: raw logs are large and machine-regenerable.
# The SUMMARY of every gate run belongs in .harness/state/progress.md, which
# IS committed. Keep the directory so the path always exists.
.harness/verification/evidence/*
!.harness/verification/evidence/.gitkeep

# Claude Code local overrides (machine-specific permissions; never shared)
.claude/settings.local.json

# Editor & OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Local databases (mobile/offline dev)
*.sqlite
*.sqlite3
*.db
!**/testdata/**/*.sqlite

# Terraform state — NEVER commit; use remote state
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/*.tfvars
!infra/terraform/**/*.tfvars.example
infra/terraform/**/.terraform.lock.hcl.local

# Scratch
tmp/
temp/
scratch/
backend.hcl

# Terraform
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl
infra/terraform/backend.hcl
*.tfstate
*.tfstate.*

# Created and removed by scripts/verify-claims-proof.mjs. Never committed.
docs/__claims_proof__.md

# Build inputs that are downloaded, not authored. The SUBSET is committed; its 9.6MB
# source is not — see scripts/generate-font-subset.mjs.
.cache/

# Uniwind's generated className types (ADR-0062). Written by the Metro plugin on every
# bundle from apps/mobile/global.css, which IS committed — this is a build artefact of a
# build artefact.
apps/mobile/src/uniwind.d.ts

# Scratch copy taken by scripts/verify-content-proof.mjs while it mutates the fixture
# corpus. The script removes it on every exit path; this is the second line of defence,
# because the one time it did not, `git add -A` committed a copy of the fixtures (F-100).
packages/corpus/test/fixtures/.valid-backup/
