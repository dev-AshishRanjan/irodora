{
  "name": "@irodora/color-difference",
  "version": "0.0.0",
  "private": false,
  "description": "Colour difference and contrast metrics.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@irodora/color-spaces": "workspace:*"
  },
  "devDependencies": {
    "@irodora/testing": "workspace:*",
    "@types/culori": "^4.0.1",
    "colorjs.io": "^0.7.1",
    "culori": "^4.0.2",
    "fast-check": "^4.9.0",
    "vitest": "^4.1.10"
  }
}
