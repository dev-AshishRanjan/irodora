{
  "name": "@irodora/store",
  "version": "0.0.0",
  "private": true,
  "description": "The device is the system of record. SQLite behind one repository interface, with a conformance suite both drivers run.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./node": {
      "types": "./dist/drivers/node.d.ts",
      "default": "./dist/drivers/node.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
