{
  "name": "@irodora/ui",
  "version": "0.0.0",
  "private": true,
  "description": "React Native components over the platform's own primitives (ADR-0054), and the conformance suite that checks them.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest --config jest.config.mjs",
    "test:contrast": "jest --config jest.config.mjs --testPathPattern conformance",
    "test:a11y": "jest --config jest.config.mjs --testPathPattern \"(conformance|components)\"",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@irodora/color-core": "workspace:*",
    "@irodora/design-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-native": ">=0.86.0",
    "heroui-native": ">=1.0.8",
    "react-native-gesture-handler": ">=2.28.0 <3"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-test-renderer": "19.2.3",
    "heroui-native": "^1.0.8",
    "react-native-gesture-handler": "^2.32.0"
  }
}
