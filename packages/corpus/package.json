{
  "name": "@irodora/corpus",
  "version": "0.0.0",
  "private": false,
  "description": "The corpus schema, provenance rules, derivation and the content gate checks.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist *.tsbuildinfo",
    "generate": "node ../../scripts/generate-corpus.mjs"
  },
  "dependencies": {
    "@irodora/color-core": "workspace:*",
    "@irodora/color-difference": "workspace:*",
    "@irodora/color-spaces": "workspace:*"
  },
  "devDependencies": {
    "@irodora/color-naming": "workspace:*",
    "@irodora/testing": "workspace:*",
    "@types/node": "^24.13.3",
    "fast-check": "^4.9.0",
    "vitest": "^4.1.10"
  }
}
