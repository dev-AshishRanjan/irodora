{
  "name": "@irodora/recommendation",
  "version": "0.0.0",
  "private": false,
  "description": "Rules, weights, scoring and explanation objects.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@irodora/color-core": "workspace:*",
    "@irodora/color-difference": "workspace:*",
    "@irodora/color-spaces": "workspace:*",
    "@irodora/corpus": "workspace:*",
    "@irodora/cvd-engine": "workspace:*"
  },
  "devDependencies": {
    "@irodora/store": "workspace:*"
  }
}
