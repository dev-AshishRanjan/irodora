{
  "name": "@irodora/ports",
  "version": "0.0.0",
  "private": false,
  "description": "Interfaces for every infrastructure dependency, and the conformance suites every adapter must pass.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
