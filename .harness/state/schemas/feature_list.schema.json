{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irodora.com/schemas/feature_list.schema.json",
  "title": "Irodora feature list",
  "description": "The scope subsystem. The scheduler picks from it, the verifier judges against it, and the handoff reports from it. wip_limit is 1 and is enforced by the state gate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "updated", "policy", "statuses", "releases", "features"],
  "properties": {
    "$schemaRef": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "project": { "type": "string" },
    "updated": { "type": "string", "format": "date" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wip_limit", "ordering"],
      "properties": {
        "wip_limit": { "type": "integer", "minimum": 1, "maximum": 1 },
        "ordering": { "type": "string" }
      }
    },
    "statuses": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "releases": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "requirements", "service", "release", "priority", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^F-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 3 },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(FR|NFR)-[0-9]+$" },
          "description": "Every id must exist in docs/PRD.md. Checked by the state gate in both directions."
        },
        "service": {
          "type": "string",
          "enum": ["root", "api", "worker", "web", "mobile", "admin", "packages", "content", "infra", "tests"]
        },
        "package": { "type": "string" },
        "release": { "type": "string", "pattern": "^R[0-9]+$" },
        "priority": { "type": "string", "enum": ["must", "should", "could", "wont"] },
        "status": {
          "type": "string",
          "enum": ["backlog", "todo", "in_progress", "blocked", "in_review", "done"]
        },
        "blockedBy": {
          "type": "array",
          "items": { "type": "string", "pattern": "^F-[0-9]{3}$" },
          "description": "Every one must be `done` before this may become in_progress or done."
        },
        "acceptance": {
          "type": "array",
          "items": { "type": "string" },
          "description": "The contract. No more, no less — extra scope is as much a failure as missing scope."
        },
        "verification": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Gate ids from .harness/verification/gates.json."
        },
        "attested": {
          "type": "array",
          "description": "Acceptance criteria that no check in this repository could prove, because verifying them requires a system we do not control (ADR-0038). Each blocks the RELEASE rather than the feature. Attestation is not an escape hatch: 'hard to test' is not the bar. Where part of a criterion is checkable, that part stays gated.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion", "verifiedBy", "blocks", "status"],
            "properties": {
              "criterion": {
                "type": "string",
                "description": "VERBATIM text of the acceptance entry this covers. The state gate checks it appears exactly in `acceptance`, so a criterion cannot be quietly reworded into something easier once it is attested."
              },
              "verifiedBy": {
                "type": "string",
                "minLength": 12,
                "description": "The activity that proves it — named specifically. 'Manual testing' is not an answer."
              },
              "blocks": { "enum": ["release", "nothing"] },
              "status": { "enum": ["outstanding", "verified"] },
              "evidence": {
                "type": "string",
                "description": "Where the verification is recorded. Required once status is `verified`."
              }
            }
          }
        },
        "effects": { "type": "array", "items": { "type": "string", "pattern": "^E-[0-9]{3}$" } },
        "openQuestions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^OQ-[0-9]+$" },
          "description": "An unresolved open question BLOCKS this feature. It closes as an ADR, not as a conversation."
        },
        "plan": { "type": "string", "description": "Path to the plan file, relative to .harness/." },
        "notes": { "type": "string" }
      }
    }
  }
}
