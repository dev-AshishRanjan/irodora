{
  "name": "@irodora/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Irodora — the app. Expo SDK 57 / React Native 0.86, New Architecture, development client. The only surface (ADR-0051).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest --config jest.config.mjs",
    "test:contrast": "jest --config jest.config.mjs --testPathPattern screens",
    "test:a11y": "jest --config jest.config.mjs --testPathPattern screens",
    "build": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist .expo *.tsbuildinfo"
  },
  "dependencies": {
    "@irodora/color-core": "workspace:*",
    "@irodora/color-difference": "workspace:*",
    "@irodora/color-naming": "workspace:*",
    "@irodora/color-sampling": "workspace:*",
    "@irodora/color-spaces": "workspace:*",
    "@irodora/contracts": "workspace:*",
    "@irodora/corpus": "workspace:*",
    "@irodora/cvd-engine": "workspace:*",
    "@irodora/design-tokens": "workspace:*",
    "@irodora/export": "workspace:*",
    "@irodora/optimization": "workspace:*",
    "@irodora/recommendation": "workspace:*",
    "@irodora/store": "workspace:*",
    "@irodora/ui": "workspace:*",
    "@noble/hashes": "2.3.0",
    "expo": "~57.0.14",
    "expo-build-properties": "~57.0.12",
    "expo-crypto": "^57.0.1",
    "expo-file-system": "^57.0.6",
    "expo-font": "^57.0.1",
    "expo-image-picker": "~57.0.14",
    "expo-localization": "^57.0.1",
    "expo-router": "~57.0.14",
    "expo-secure-store": "^57.0.1",
    "expo-sharing": "^57.0.17",
    "expo-sqlite": "^57.0.1",
    "expo-status-bar": "~57.0.1",
    "heroui-native": "^1.0.8",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.7.0",
