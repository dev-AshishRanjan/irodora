{
  "name": "@irodora/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background jobs — the only process that decodes images.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist *.tsbuildinfo",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@irodora/adapters": "workspace:*",
    "@irodora/config": "workspace:*",
    "@irodora/ports": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "vitest": "^4.1.10"
  }
}
