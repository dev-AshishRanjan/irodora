{
  "name": "@irodora/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify modular monolith. Implemented from F-015.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "generate:openapi": "node ../../scripts/generate-openapi.mjs",
    "check:openapi": "node ../../scripts/generate-openapi.mjs --check",
    "clean": "rimraf dist *.tsbuildinfo",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@irodora/adapters": "workspace:*",
    "@irodora/config": "workspace:*",
    "@irodora/contracts": "workspace:*",
    "@irodora/ports": "workspace:*",
    "ajv": "^8.20.0",
    "fastify": "^5.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vitest": "^4.1.10",
    "@types/node": "^24.13.3"
  }
}
