# Copy to backend.hcl and fill in. backend.hcl is gitignored — it names infrastructure,
# not secrets, but it differs per environment and does not belong in the repository.
#
#   terraform init -backend-config=backend.hcl

bucket = "replace-me-irodora-tfstate"
key    = "cloud/terraform.tfstate"
region = "eu-west-1"

# Versioning on the bucket is not optional: it is the only way back from a corrupted
# or truncated state file.
encrypt = true

# State locking. Without it two applies can run concurrently and the second overwrites
# the first's view of the world.
use_lockfile = true
