# ---------------------------------------------------------------------------
# Values docker-compose.prod.yml needs.
#
# On a VPS you do NOT create this file: Coolify and Dokploy both inject
# environment from their own UI, which is why the compose file uses
# `environment:` with ${VAR} rather than `env_file:` — the portability check
# rejects `env_file` for exactly that reason.
#
# Copy this to `.env` beside the compose file only when running the stack
# locally. `.env` is gitignored; this file is not.
#
# Every value below is a PLACEHOLDER and the loader rejects them under the vps
# and cloud profiles (packages/config). A deployment shipping `replace-me`
# refuses to boot rather than running with a known secret.
# ---------------------------------------------------------------------------

IRODORA_PROFILE=vps
IRODORA_LOG_LEVEL=info

# Public URLs — used for CORS, cookies and absolute links in mail.
IRODORA_PUBLIC_API_URL=https://api.example.com
IRODORA_PUBLIC_WEB_URL=https://example.com

# Postgres. The user and database name have defaults in the compose file; the
# password does not, deliberately — a default password is a password.
POSTGRES_USER=irodora
POSTGRES_DB=irodora
POSTGRES_PASSWORD=replace-me

# Only the API migrates at boot. The worker is pinned to 0 in the compose file.
IRODORA_DATABASE_MIGRATE_ON_BOOT=1

# Object storage (MinIO in this stack; any S3-compatible endpoint elsewhere).
# These are also MinIO's root credentials — one identity, so there is no way for
# the two to drift apart.
IRODORA_BLOB_REGION=us-east-1
IRODORA_BLOB_BUCKET=irodora
IRODORA_BLOB_ACCESS_KEY_ID=replace-me
IRODORA_BLOB_SECRET_ACCESS_KEY=replace-me

# OIDC. The provider itself is OQ-1 and lands with F-033.
IRODORA_OIDC_ISSUER=https://auth.example.com
IRODORA_OIDC_CLIENT_ID=irodora-api
IRODORA_OIDC_CLIENT_SECRET=replace-me
IRODORA_OIDC_AUDIENCE=irodora-api

# 32 bytes or more. `openssl rand -base64 32`
IRODORA_SESSION_SECRET=replace-me-with-32-plus-random-bytes-base64
IRODORA_SESSION_COOKIE_DOMAIN=example.com

IRODORA_WEBAUTHN_RP_ID=example.com
IRODORA_WEBAUTHN_RP_NAME=Irodora

IRODORA_MAIL_FROM=no-reply@example.com
