{
  "name": "irodora",
  "version": "0.0.0",
  "private": true,
  "description": "Irodora — a deterministic colour intelligence platform for what you wear.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "verify:state": "node scripts/verify-state.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && node scripts/verify-guards.mjs && node scripts/verify-engine-purity.mjs && node scripts/verify-unsafe-call-sites.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:golden": "turbo run test:golden",
    "test:cvd": "turbo run test:cvd",
    "test:content": "node scripts/verify-content.mjs",
    "build": "turbo run build",
    "test:e2e": "node scripts/e2e-scope.mjs && turbo run test:e2e",
    "test:a11y": "turbo run test:a11y",
    "test:contrast": "turbo run test:contrast",
    "bench": "pnpm --filter @irodora/bench test",
    "security:secrets": "gitleaks detect --no-banner --redact --config .gitleaks.toml",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "verify:mirror": "node scripts/verify-gate-mirror.mjs",
    "clean": "turbo run clean && rimraf node_modules",
    "verify:guards": "node scripts/verify-guards.mjs",
    "verify:purity": "node scripts/verify-engine-purity.mjs",
    "verify:purity:prove": "node scripts/verify-engine-purity.mjs --prove",
    "security:staged": "gitleaks protect --staged --no-banner --redact --config .gitleaks.toml",
    "verify:unsafe": "node scripts/verify-unsafe-call-sites.mjs",
    "verify:pin": "node scripts/verify-contract-pin.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
