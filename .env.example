# ---------------------------------------------------------------------------
# Irodora — environment contract
#
# This file IS the contract. The `state` gate fails if any IRODORA_* variable
# read by packages/config is missing here, and the config loader fails fast at
# boot on a missing required variable rather than degrading silently.
#
# Copy to .env for local development. Never commit .env.
# On Coolify / Dokploy, paste these into the environment UI.
# ---------------------------------------------------------------------------

# === Profile ================================================================
# local | vps | cloud — selects the adapter set behind each port.
# See docs/adr/0016-deployment-profiles-local-vps-cloud.md
IRODORA_PROFILE=local
NODE_ENV=development

# === Service identity =======================================================
IRODORA_SERVICE_NAME=api
IRODORA_LOG_LEVEL=info
IRODORA_HTTP_HOST=0.0.0.0
IRODORA_HTTP_PORT=3000

# Public origins. Used for CORS, cookie domain, absolute URLs in shared cards.
IRODORA_PUBLIC_WEB_URL=http://localhost:3001
IRODORA_PUBLIC_API_URL=http://localhost:3000

# === Database ===============================================================
IRODORA_DATABASE_URL=postgres://irodora:irodora@localhost:5432/irodora
IRODORA_DATABASE_POOL_MAX=10
# Run pending migrations at boot behind an advisory lock. Safe for the VPS
# profile where there is no separate migration step; set 0 in cloud, where
# migrations run as their own task.
IRODORA_DATABASE_MIGRATE_ON_BOOT=1

# === Cache and queue ========================================================
IRODORA_REDIS_URL=redis://localhost:6379
IRODORA_QUEUE_PREFIX=irodora

# === Object storage (S3-compatible: MinIO, Garage, R2, B2, S3) ==============
IRODORA_BLOB_ENDPOINT=http://localhost:9000
IRODORA_BLOB_REGION=us-east-1
IRODORA_BLOB_BUCKET=irodora-local
IRODORA_BLOB_ACCESS_KEY_ID=replace-me
IRODORA_BLOB_SECRET_ACCESS_KEY=replace-me
# MinIO and most self-hosted S3 need path-style addressing; AWS does not.
IRODORA_BLOB_FORCE_PATH_STYLE=1

# === Authentication =========================================================
# OIDC issuer. See docs/adr/0015-auth-oidc-passkeys-no-homegrown-crypto.md
IRODORA_OIDC_ISSUER=http://localhost:8080/realms/irodora
IRODORA_OIDC_CLIENT_ID=irodora-api
IRODORA_OIDC_CLIENT_SECRET=replace-me
IRODORA_OIDC_AUDIENCE=irodora-api

# Session cookie signing. 32+ random bytes, base64. Rotate via the two-key
# window described in docs/operations/runbook.md — never by replacing in place.
IRODORA_SESSION_SECRET=replace-me-with-32-plus-random-bytes-base64
IRODORA_SESSION_COOKIE_DOMAIN=localhost

# WebAuthn / passkeys
IRODORA_WEBAUTHN_RP_ID=localhost
IRODORA_WEBAUTHN_RP_NAME=Irodora

# === Encryption =============================================================
# Envelope encryption for wardrobe imagery. In the cloud profile this names a
# KMS key; in local/vps it is a base64 master key held by the operator.
# This is NOT end-to-end encryption — see docs/architecture/security/privacy-design.md
IRODORA_KMS_PROVIDER=local
IRODORA_KMS_LOCAL_MASTER_KEY=replace-me-with-32-random-bytes-base64
IRODORA_KMS_KEY_ID=

# === Mail ===================================================================
IRODORA_MAIL_TRANSPORT=smtp
IRODORA_SMTP_URL=smtp://localhost:1025
IRODORA_MAIL_FROM=no-reply@irodora.com

# === Content and engine versioning ==========================================
# Pinning these makes a recommendation reproducible. Empty means "latest
# published", which is correct in development and forbidden in production.
# See docs/adr/0011-recommendation-rules-are-versioned-content.md
IRODORA_CONTENT_VERSION=
IRODORA_RULES_VERSION=

# === Observability ==========================================================
IRODORA_OTEL_ENABLED=0
IRODORA_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
IRODORA_OTEL_SERVICE_NAMESPACE=irodora

# === Rate limiting ==========================================================
IRODORA_RATE_LIMIT_GLOBAL_PER_MINUTE=600
IRODORA_RATE_LIMIT_AUTH_PER_MINUTE=10
IRODORA_RATE_LIMIT_UPLOAD_PER_MINUTE=30

# === Image handling =========================================================
# Attacker-controlled binary input. Bounded hard. See SECURITY.md.
IRODORA_IMAGE_MAX_BYTES=12582912
IRODORA_IMAGE_MAX_PIXELS=40000000
IRODORA_IMAGE_DECODE_TIMEOUT_MS=5000

# === Feature flags ==========================================================
IRODORA_FEATURE_CALIBRATED_SCAN=0
IRODORA_FEATURE_PRO_EXPORTS=0
IRODORA_FEATURE_PUBLIC_API=0

# === Web application (apps/web) =============================================
NEXT_PUBLIC_IRODORA_API_URL=http://localhost:3000
NEXT_PUBLIC_IRODORA_DEFAULT_LOCALE=en
